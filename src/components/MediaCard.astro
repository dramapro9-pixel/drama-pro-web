---
import type { MediaItem, SupportedLang } from '../utils/types';
import { getLocalizedField, getTranslation } from '../utils/i18n';

interface Props {
  item: MediaItem;
  lang: SupportedLang;
}

const { item, lang } = Astro.props;
const t = getTranslation(lang);

const title = getLocalizedField(item, 'title', lang);
const typePath = item.type === 'series' ? 'series' : 'movie';
const detailUrl = `/${lang}/${typePath}/${item.id}`;
const poster = item.posterUrl || item.backdropUrl || '/images/placeholder.jpg';
---

<a href={detailUrl} class="group relative flex flex-col bg-[#13151f] rounded-2xl overflow-hidden border border-gray-800/90 hover:border-orange-500/70 transition-all duration-300 hover:shadow-xl hover:shadow-orange-950/30 hover:-translate-y-1.5">
  <!-- Poster Image Container -->
  <div class="relative aspect-[2/3] w-full overflow-hidden bg-gray-900">
    <img
      src={poster}
      alt={title}
      loading="lazy"
      decoding="async"
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
      onerror="this.onerror=null; this.src='https://via.placeholder.com/300x450/13151f/ffffff?text=Drama+Pro';"
    />

    <!-- Dark Gradient Overlay -->
    <div class="absolute inset-0 bg-gradient-to-t from-[#13151f] via-transparent to-black/30 opacity-80 group-hover:opacity-90 transition-opacity"></div>

    <!-- Rating & Type Badge -->
    <div class="absolute top-2.5 left-2.5 right-2.5 flex items-center justify-between pointer-events-none">
      {item.rating > 0 && (
        <span class="inline-flex items-center gap-1 bg-black/80 backdrop-blur-md text-amber-400 text-xs font-bold px-2 py-0.5 rounded-lg border border-amber-500/40">
          <svg class="w-3 h-3 fill-current text-amber-400" viewBox="0 0 20 20">
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
          </svg>
          {item.rating.toFixed(1)}
        </span>
      )}

      <span class={`text-[10px] font-extrabold px-2 py-0.5 rounded-lg uppercase tracking-wider backdrop-blur-md ${item.type === 'series' ? 'bg-purple-950/90 text-purple-300 border border-purple-500/40' : 'bg-orange-950/90 text-orange-300 border border-orange-500/40'}`}>
        {item.type === 'series' ? t.series : t.movies}
      </span>
    </div>

    <!-- Badge if present (NEW / EXCLUSIVE) -->
    {item.badge && (
      <div class="absolute bottom-3 right-3 bg-gradient-to-r from-orange-500 to-amber-600 text-black font-black text-[10px] px-2 py-0.5 rounded uppercase tracking-wider shadow-md">
        {item.badge}
      </div>
    )}
  </div>

  <!-- Content details -->
  <div class="p-4 flex flex-col gap-1.5 flex-grow">
    <h3 class="font-extrabold text-sm text-gray-100 group-hover:text-orange-400 transition-colors line-clamp-1">
      {title}
    </h3>

    <div class="flex items-center justify-between text-xs text-gray-400 mt-auto pt-1">
      {item.releaseYear > 0 && (
        <span class="font-semibold text-gray-400">{item.releaseYear}</span>
      )}
      {item.category && (
        <span class="text-orange-400/90 font-bold truncate max-w-[120px]">{item.category}</span>
      )}
    </div>
  </div>
</a>
