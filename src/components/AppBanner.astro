---
import type { SupportedLang } from '../utils/types';
import { getTranslation } from '../utils/i18n';

interface Props {
  lang: SupportedLang;
  title?: string;
}

const { lang, title } = Astro.props;
const t = getTranslation(lang);
---

<div id="download-app" class="relative overflow-hidden rounded-3xl bg-gradient-to-r from-orange-950/80 via-[#161824] to-[#0a0b12] border border-orange-600/30 p-6 sm:p-10 shadow-2xl shadow-orange-950/20 my-12">
  <!-- Background Glow -->
  <div class="absolute -top-24 -right-24 w-96 h-96 bg-orange-600/15 rounded-full blur-3xl pointer-events-none"></div>

  <div class="relative z-10 flex flex-col md:flex-row items-center justify-between gap-8">
    <div class="flex flex-col sm:flex-row items-center gap-6 text-center sm:text-start">
      <!-- App Logo Badge -->
      <div class="w-16 h-16 sm:w-20 sm:h-20 flex-shrink-0 rounded-2xl overflow-hidden shadow-2xl shadow-orange-950/80 border-2 border-amber-500/40">
        <img src="/logo.png" alt="Drama Pro App" class="w-full h-full object-cover" />
      </div>

      <div class="space-y-2 max-w-xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-orange-950/60 border border-orange-600/50 text-orange-400 text-xs font-black uppercase tracking-wider">
          <svg class="w-4 h-4 fill-current text-orange-500" viewBox="0 0 24 24">
            <path d="M17.523 15.3414c-.5511 0-.9993-.4486-.9993-.9997s.4482-.9993.9993-.9993c.552 0 1 .4482 1 .9993s-.448.9997-1 .9997zm-11.046 0c-.5511 0-.9993-.4486-.9993-.9997s.4482-.9993.9993-.9993c.552 0 1 .4482 1 .9993s-.448.9997-1 .9997zm11.4045-6.02l1.9973-3.4592a.416.416 0 00-.1523-.5676.416.416 0 00-.5677.1523l-2.0223 3.5028c-1.2854-.5858-2.734-.9167-4.2865-.9167-1.5526 0-3.0012.3309-4.2866.9167l-2.0223-3.5028a.4158.4158 0 00-.5677-.1523.416.416 0 00-.1523.5676l1.9973 3.4592c-3.0645 1.6669-5.1843 4.8028-5.4678 8.4784h19.0068c-.2835-3.6756-2.4033-6.8115-5.4678-8.4784z"/>
          </svg>
          <span>Drama Pro Android App</span>
        </div>

        <h2 class="text-2xl sm:text-3xl font-black text-white leading-tight">
          {title ? `${t.watchOnApp}: ${title}` : t.watchOnApp}
        </h2>

        <p class="text-sm text-gray-300 leading-relaxed">
          {t.watchInAppPrompt}
        </p>
      </div>
    </div>

    <!-- Download CTA Action -->
    <div class="flex flex-col sm:flex-row items-center gap-3 w-full md:w-auto flex-shrink-0">
      <a
        href="/download/"
        class="w-full sm:w-auto px-8 py-4 rounded-2xl bg-gradient-to-r from-orange-500 via-orange-600 to-amber-600 hover:from-orange-600 hover:to-amber-700 text-black font-black text-sm shadow-xl shadow-orange-950/60 hover:shadow-orange-800/80 transition-all text-center flex items-center justify-center gap-2.5 group hover:scale-105"
      >
        <svg class="w-5 h-5 fill-current text-black group-hover:scale-110 transition-transform" viewBox="0 0 24 24">
          <path d="M8 5v14l11-7z"/>
        </svg>
        <span>{t.watchOnApp}</span>
      </a>
    </div>
  </div>
</div>
